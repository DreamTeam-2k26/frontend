{
  "name": "hackathon2026",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:dashboard": "node --test --test-isolation=none tests/dashboard/*.test.js",
    "test:folders": "node --test --test-isolation=none tests/folders/*.test.js",
    "test:projects": "node --test --test-isolation=none tests/projects/*.test.js",
    "test:kanban": "node --test --test-isolation=none tests/kanban/*.test.js",
    "test:chat": "node --test \"src/features/chat/__tests__/*.test.js\"",
    "test:calls": "node --test \"src/features/calls/__tests__/*.test.js\"",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/",
    "test:members": "node --test --test-isolation=none tests/members/*.test.js",
    "test:google": "node --test --test-isolation=none tests/google/*.test.js",
    "test:files": "node --test --test-isolation=none tests/files/*.test.js",
    "test:links": "node --test --test-isolation=none tests/links/*.test.js"
    "test:activities": "node --test --test-isolation=none tests/activities/*.test.js"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1",
    "vue3-toastify": "^0.2.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.82.0",
    "eslint-plugin-vue": "~10.11.0",
    "globals": "^17.12.0",
    "npm-run-all2": "^9.0.3",
    "oxlint": "~1.82.0",
    "prettier": "3.9.6",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-eslint-parser": "^10.4.1"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
