# URL da API com /api; HTTPS em produção.
VITE_API_URL=http://localhost:8000/api
VITE_ACCESS_TOKEN_KEY=fluxo-access-token
VITE_REFRESH_TOKEN_KEY=fluxo-refresh-token
# Client ID público OAuth 2.0 do tipo Web (mesmo GOOGLE_CLIENT_ID no Django).
# Nunca inclua client_secret ou chaves privadas em variáveis VITE_*.
VITE_GOOGLE_CLIENT_ID=
